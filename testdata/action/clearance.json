{
  "version": "v1",
  "adapters": {
    "required": ["recorded-scanner"],
    "optional": []
  },
  "paths": {
    "include": ["**/*"],
    "exclude": [".git/**", "vendor/**", "node_modules/**"]
  },
  "scopes": {
    "quick": {
      "adapters": ["recorded-scanner"],
      "commands": [],
      "allow_dirty": true
    },
    "full": {
      "adapters": ["recorded-scanner"],
      "commands": [],
      "allow_dirty": false
    },
    "release": {
      "adapters": ["recorded-scanner"],
      "commands": [],
      "allow_dirty": false
    }
  },
  "policy": {
    "blocking_severities": ["critical", "high"],
    "allow_dirty": false,
    "accepted_risks": []
  },
  "commands": {
    "required": [],
    "optional": []
  },
  "limits": {
    "timeout_seconds": 60,
    "max_concurrency": 2
  },
  "outcomes": {
    "minimum_evidence": {
      "cleared": {
        "required_adapters_must_pass": true,
        "zero_blocking_findings": true,
        "clean_tree_required": true
      },
      "cleared_with_residual_risk": {
        "accepted_risks_unexpired": true
      },
      "blocked": {
        "blocking_finding_present": true
      },
      "incomplete": {
        "missing_required_adapter": true,
        "crashed_or_timed_out": true
      }
    }
  }
}
