{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "semgrep",
          "semanticVersion": "v1.90.0",
          "rules": [
            {
              "id": "rules.python.security.injection.hardcoded-sql-expression",
              "shortDescription": {
                "text": "Detected possible SQL injection through string formatting or concatenation."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "rules.python.security.injection.hardcoded-sql-expression",
          "level": "warning",
          "message": {
            "text": "Possible SQL injection detected in database query execution."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/views.py"
                },
                "region": {
                  "startLine": 14,
                  "startColumn": 5,
                  "endLine": 14,
                  "endColumn": 65,
                  "snippet": {
                    "text": "cursor.execute(\"SELECT * FROM users WHERE id = '%s'\" % user_id)"
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
